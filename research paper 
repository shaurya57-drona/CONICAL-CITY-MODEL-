import React, { createContext, useContext, useState, useEffect } from 'react';
import { BrowserRouter as Router, Routes, Route } from 'react-router-dom';
import Header from './components/Header';
import Footer from './components/Footer';
import Home from './pages/Home';
import ShapePage from './pages/ShapePage';
import ComparePage from './pages/ComparePage';

// Language Context for global state
const LanguageContext = createContext();

export function useLanguage() {
  return useContext(LanguageContext);
}

export default function App() {
  // Load language preference from localStorage on mount
  const [language, setLanguage] = useState(() => {
    return localStorage.getItem('language') || 'en';
  });

  // Save language to localStorage whenever it changes
  useEffect(() => {
    localStorage.setItem('language', language);
  }, [language]);

  // Toggle between English and Hindi
  const toggleLanguage = () => {
    setLanguage(prev => prev === 'en' ? 'hi' : 'en');
  };

  return (
    <LanguageContext.Provider value={{ language, toggleLanguage }}>
      <Router>
        <div className="app-container">
          <Header />
          
          <main className="main-content">
            <Routes>
              <Route path="/" element={<Home />} />
              <Route path="/circle" element={<ShapePage shape="circle" />} />
              <Route path="/parabola" element={<ShapePage shape="parabola" />} />
              <Route path="/ellipse" element={<ShapePage shape="ellipse" />} />
              <Route path="/hyperbola" element={<ShapePage shape="hyperbola" />} />
              <Route path="/compare" element={<ComparePage />} />
              <Route path="*" element={<Home />} />
            </Routes>
          </main>

          <Footer />
        </div>
      </Router>
    </LanguageContext.Provider>
  );
}
